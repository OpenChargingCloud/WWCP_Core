<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>cloud.charging.open.protocols.WWCP.WebAPI</RootNamespace>
    <AssemblyName>cloud.charging.open.protocols.WWCP.WebAPI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="HTTPRoot\chargingSessions\chargingSessions.js" />
    <None Remove="HTTPRoot\chargingSessions\chargingSessions.js.map" />
    <None Remove="HTTPRoot\css\chargingSessions\chargingSessions.css" />
    <None Remove="HTTPRoot\css\chargingSessions\chargingSessions.min.css" />
    <None Remove="HTTPRoot\css\debugLog\debugLog.css" />
    <None Remove="HTTPRoot\css\debugLog\debugLog.min.css" />
    <None Remove="HTTPRoot\css\index.css" />
    <None Remove="HTTPRoot\css\index.min.css" />
    <None Remove="HTTPRoot\css\template.css" />
    <None Remove="HTTPRoot\css\template.min.css" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="HTTPRoot\chargingSessions\chargingSessions.js" />
    <EmbeddedResource Include="HTTPRoot\chargingSessions\chargingSessions.js.map" />
    <EmbeddedResource Include="HTTPRoot\chargingSessions\chargingSessions.scss" />
    <EmbeddedResource Include="HTTPRoot\chargingSessions\chargingSessions.shtml" />
    <EmbeddedResource Include="HTTPRoot\chargingSessions\chargingSessions.ts" />
    <EmbeddedResource Include="HTTPRoot\css\chargingSessions\chargingSessions.css" />
    <EmbeddedResource Include="HTTPRoot\css\chargingSessions\chargingSessions.min.css" />
    <EmbeddedResource Include="HTTPRoot\css\debugLog\debugLog.css" />
    <EmbeddedResource Include="HTTPRoot\css\debugLog\debugLog.min.css" />
    <EmbeddedResource Include="HTTPRoot\css\index.css" />
    <EmbeddedResource Include="HTTPRoot\css\index.min.css" />
    <EmbeddedResource Include="HTTPRoot\css\template.css" />
    <EmbeddedResource Include="HTTPRoot\css\template.min.css" />
    <EmbeddedResource Include="HTTPRoot\debugLog\debugLog.js" />
    <EmbeddedResource Include="HTTPRoot\debugLog\debugLog.js.map" />
    <EmbeddedResource Include="HTTPRoot\debugLog\debugLog.scss" />
    <EmbeddedResource Include="HTTPRoot\debugLog\debugLog.shtml" />
    <EmbeddedResource Include="HTTPRoot\debugLog\debugLog.ts" />
    <EmbeddedResource Include="HTTPRoot\defaults\defaults.js" />
    <EmbeddedResource Include="HTTPRoot\defaults\defaults.js.map" />
    <EmbeddedResource Include="HTTPRoot\defaults\defaults.ts" />
    <EmbeddedResource Include="HTTPRoot\defaults\_defaults.scss" />
    <EmbeddedResource Include="HTTPRoot\favicon.png" />
    <EmbeddedResource Include="HTTPRoot\images\favicon_big.png" />
    <EmbeddedResource Include="HTTPRoot\index.scss" />
    <EmbeddedResource Include="HTTPRoot\index.shtml" />
    <EmbeddedResource Include="HTTPRoot\support\support.shtml" />
    <EmbeddedResource Include="HTTPRoot\template.html" />
    <EmbeddedResource Include="HTTPRoot\template.scss" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WWCP_HTTPAPI\WWCP_HTTPAPI.csproj" />
  </ItemGroup>

  <!-- The compiler comes with the repository rather than from whichever
       machine is building; Directory.Build.targets at the repository root
       says why, and package.json beside it pins the version. -->
  <Target Name="CompileWebAssets" BeforeTargets="PreBuildEvent" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(NodeToolsRoot)" Condition="!Exists('$(NodeToolsRoot)node_modules')" />
    <Exec Command="node &quot;$(TypeScriptCompiler)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="node &quot;$(StylesheetCompiler)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
